# Copy this to .env and fill values (DO NOT commit .env with secrets)
GROQ_API_KEY=your_groq_api_key_here
SUPABASE_URL=https://your-project.supabase.co
# Use the service_role key for server-side operations (starts with 'service_role.')
SUPABASE_SERVICE_KEY=service_role.your_service_role_key_here
CORS_ORIGINS=http://localhost:5173,https://localhost:5173
PORT=3001
