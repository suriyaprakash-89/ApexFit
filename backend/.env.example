# Copy this to .env and fill values (DO NOT commit .env with secrets)
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the Groq models (check https://console.groq.com/docs/models)
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
SUPABASE_URL=https://your-project.supabase.co
# Must be the SECRET service_role key (JWT "service_role" or "sb_secret_..."), never the publishable/anon key
SUPABASE_SERVICE_KEY=your_service_role_key_here
CORS_ORIGINS=http://localhost:5173,https://localhost:5173
PORT=3001
